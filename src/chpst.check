#!/bin/sh
rm -rf "${ctmp}"

chpst
echo $?
chpst -V
echo $?

# -u
# -U

mkdir "${ctmp}"
echo 1 >"${ctmp}"/test
chpst -e"${ctmp}" env |sed -ne '/^test=1$/p'
echo $?
rm -rf "${ctmp}"

chpst -l"${ctmp}" true
echo $?
rm -f "${ctmp}"

chpst -L"${ctmp}" true
echo $?
rm -f "${ctmp}"

# -m
# -o
# -p
# -f
# -c

chpst -P true
echo $?

chpst -012 true
echo $?

chpst -2 ./ENOENT.err 2>/dev/null
echo $?
chpst -012 ./ENOENT.err

chpst -N012 true
echo $?
chpst -N2 ./ENOENT.err 2>/dev/null
echo $?
chpst -N012 ./ENOENT.err

chpst -A 2 /bin/sh -c 'trap "echo ALRM" ALRM; sleep 5 & wait $!'

chpst -A 1 chpst -A 0 /bin/sh -c 'trap "echo ALRM" ALRM; sleep 2 & wait $!'
echo $?
