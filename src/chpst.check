#!/bin/sh
rm -rf "${ctmp}"

chpst
echo $?
chpst -V
echo $?

# -u
# -U

mkdir "${ctmp}"
echo 1 >"${ctmp}"/test
chpst -e"${ctmp}" env |sed -ne '/^test=1$/p'
echo $?
rm -rf "${ctmp}"

chpst -l"${ctmp}" true
echo $?
rm -f "${ctmp}"

chpst -L"${ctmp}" true
echo $?
rm -f "${ctmp}"

# -m
# -o
# -p
# -f
# -c

chpst -P true
echo $?

chpst -012 true
echo $?

/bin/sh -c 'kill -s ALRM $$' 2>/dev/null
EC_ALRM=$?

/bin/sh -c 'chpst -A 2 sleep 10' 2>/dev/null
test $? -eq $EC_ALRM && echo ALRM

chpst -A 2 chpst -A 0 sleep 2
echo $?
